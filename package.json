{
  "name": "ia2interactive",
  "version": "1.0.0",
  "description": "Convierte contenido generado por IA en experiencias web interactivas de aprendizaje",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "ia2interactive": "./lib/cli.js"
  },
  "exports": {
    ".": {
      "import": "./lib/index.js",
      "types": "./lib/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build:example": "npm run build && node lib/cli.js build examples/aws-iam",
    "start": "npm run build:example && npx serve dist",
    "predeploy": "npm run build:example",
    "deploy": "npx gh-pages -d dist"
  },
  "keywords": [
    "interactive",
    "learning",
    "quiz",
    "markdown",
    "static-site"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.11",
    "@vitest/coverage-v8": "^3.2.4",
    "gh-pages": "^6.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=18"
  }
}
